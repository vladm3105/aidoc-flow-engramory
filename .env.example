# ---- Engramory dev environment (.env) ----
# Copy to .env and fill in. NEVER commit .env.

# Postgres (spine: relational + pgvector + canonical memory)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Published host port for the compose postgres (set when 5432 is taken locally)
# POSTGRES_HOST_PORT=55432
POSTGRES_DB=engramory
POSTGRES_USER=engramory
POSTGRES_PASSWORD=change_me

# Redis (L1 session cache / events)
REDIS_URL=redis://localhost:6379/0

# SeaweedFS / S3 Object Storage (SeaweedFS for dev, Cloudflare R2 for stage/prod)
S3_ENDPOINT=http://localhost:9000
AWS_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=s3admin
AWS_SECRET_ACCESS_KEY=s3admin
S3_ACCESS_KEY=s3admin
S3_SECRET_KEY=s3admin
S3_BUCKET=engramory
AWS_S3_FORCE_PATH_STYLE=true
AWS_REGION=us-east-1

# Neo4j (graph engine; enable when graph features are needed).
# NEO4J_USER seeds the container's NEO4J_AUTH; the dev default is 'neo4j'.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me

# ---- AI Gateway & Routing (Stage Platform First) ----
# Primary: Shared LiteLLM + Laya Smart Router running on Stage (Tailscale: 100.98.134.10)
# Fallback (dev): http://localhost:4000 (shared aidoc-litellm-proxy on dev)
LITELLM_BASE_URL=http://100.98.134.10:4001
LITELLM_MASTER_KEY=sk-litellm-proxy-token
OLLAMA_HOST=http://localhost:11434

# ---- Observability & Telemetry (Stage Platform First) ----
# Primary: Shared OTel Collector & APM running on Stage (platform-observability-monitoring)
OTEL_EXPORTER_OTLP_ENDPOINT=http://100.98.134.10:4318
LANGFUSE_HOST=http://100.98.134.10:13000
HYPERDX_URL=http://100.98.134.10:18080
COROOT_URL=http://100.98.134.10:18085

# Embeddings (record model + dims so memory can be re-embedded on migration)
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMS=768

# Identity Provider (Authentik per platform standard Doc 27; Keycloak is legacy)
AUTHENTIK_URL=http://100.98.134.10:9000
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=engramory

# Deployment profile: dev | gcp | azure  (selects adapters)
ENGRAMORY_PROFILE=dev
