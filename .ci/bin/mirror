#!/usr/bin/env bash
# aidoc-local-flow-ci mirror — push-mirror Gitea refs to the GitHub replica (D2) + freshness.
# The replica is verified, never trusted: promote requires replica head == Gitea head,
# and the mirror never force-pushes (a diverged replica refuses loudly — someone pushed
# to GitHub directly). Pure git transport; credentials are the operator's ambient git
# auth (machine-user PAT via a credential helper — the script never touches secrets).
#
#   mirror              sync MIRROR_REFS (+ v* tags) from the push remote to MIRROR_REMOTE
#   mirror --check      read-only freshness report (JSON); exit 0 fresh-or-unconfigured,
#                       10 stale, 3 cannot evaluate
#   mirror --pull       split forge: fast-forward the GitHub promotion branches into Gitea (back-merges)
# Identity: MIRROR_APP_ID + MIRROR_APP_KEY_FILE (env) = the mirror GitHub App (PLAN-007 G4); else ambient auth.
# .ci-config: MIRROR_ENABLED=1 · MIRROR_REMOTE=github · MIRROR_REFS="" (= chain:
#   BASE_BRANCH + PROMOTION_BRANCHES) · MIRROR_LAG_MIN=60 (inbox threshold)
# Split forge (PROMOTION_FORGE=github, #48): the default refs are BASE_BRANCH only and no tags
#   are mirrored (the promotion branches and v* tags are GitHub-native there).
# State: $(git rev-parse --absolute-git-dir)/aidoc-ci/mirror.json (local, uncommitted).
# Mirror applies to gitea-forge projects only; elsewhere (and with MIRROR_ENABLED=0,
# the drop path) --check reports configured:false and the run is a no-op.
# Exit (run): 0 synced-or-current · 3 error (incl. diverged: fix the replica, never force)
set -uo pipefail
# shellcheck source=lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
root=$(ci_root) || { echo "mirror: not in a git repo" >&2; exit 3; }
cd "$root" || exit 3

die() { echo "mirror: $*" >&2; exit 3; }
mode=${1:-run}
[[ $mode == run || $mode == --check || $mode == --pull ]] || die "usage: task mirror [-- --check | --pull]"
if [[ $(ci_forge) != gitea || $(ci_config MIRROR_ENABLED 1) != 1 ]]; then
  if [[ $mode == --check ]]; then echo '{"configured":false}'; exit 0; fi
  echo "mirror: not applicable here (non-gitea forge or MIRROR_ENABLED=0) — nothing to do" >&2
  exit 0
fi
mtarget=$(ci_config MIRROR_REMOTE github)
if ! git remote get-url "$mtarget" >/dev/null 2>&1; then
  # Misconfigured-but-enabled is an attention state, not a transport error.
  if [[ $mode == --check ]]; then
    jq -n --arg r "$mtarget" '{configured:true, refs:{}, tags_equal:false, lag_min:null, fresh:false,
      reasons:["remote \($r) missing (MIRROR_REMOTE)"]}'
    exit 10
  fi
  die "remote '$mtarget' missing (MIRROR_REMOTE)"
fi
msrc=$(ci_push_remote)

# Mirror identity (PLAN-007 G4): with MIRROR_APP_ID (+ MIRROR_APP_KEY_FILE in the environment) the
# GitHub side is reached as the mirror GitHub App, through a 1 h installation token limited to this
# repository (Contents: write). The token travels to git as GIT_CONFIG_* environment entries, never
# argv or a config file. Without it, ambient git auth applies (the old machine-user path).
app_id=${MIRROR_APP_ID:-$(ci_config MIRROR_APP_ID "")}
murl=$(git config --get "remote.$mtarget.url")   # as configured (insteadOf rewrites stay transport-only)
if [[ -n $app_id && $murl == https://github.com/* ]]; then
  mslug=$(sed -E 's#^https://github.com/##; s#\.git$##' <<<"$murl")
  tok=$(MIRROR_APP_ID=$app_id bash "${CI_GITHUB_APP_TOKEN_BIN:-$(dirname "${BASH_SOURCE[0]}")/github-app-token}" \
        "$mslug" '{"contents":"write"}') || die "cannot mint the mirror App token for $mslug"
  i=${GIT_CONFIG_COUNT:-0}
  export "GIT_CONFIG_KEY_$i=http.https://github.com/.extraheader" \
         "GIT_CONFIG_VALUE_$i=AUTHORIZATION: basic $(printf 'x-access-token:%s' "$tok" | base64 | tr -d '\n')" \
         "GIT_CONFIG_COUNT=$((i + 1))"
  unset tok
fi

# --pull (G9): GitHub-native promotion branches into Gitea as mirror-only copies, so a back-merge PR
# (staging -> dev) can run on Gitea. Fast-forward only, exact SHAs, never force.
if [[ $mode == --pull ]]; then
  ci_split_forge || die "--pull applies to the split forge only (PROMOTION_FORGE=github)"
  git fetch --quiet "$mtarget" 2>/dev/null || die "cannot fetch $mtarget"
  git fetch --quiet "$msrc" 2>/dev/null || die "cannot fetch $msrc"
  pulled=0
  for r in $(ci_list PROMOTION_BRANCHES ""); do
    g=$(git rev-parse --verify -q "refs/remotes/$mtarget/$r") || { echo "mirror: '$r' absent on $mtarget" >&2; continue; }
    c=$(git rev-parse --verify -q "refs/remotes/$msrc/$r") || c=""
    [[ $c == "$g" ]] && continue
    if [[ -n $c ]] && ! git merge-base --is-ancestor "$c" "$g" 2>/dev/null; then
      die "the $msrc copy of '$r' diverged from $mtarget (pushed to directly?) — fix it by hand, never force"
    fi
    git push --quiet "$msrc" "$g:refs/heads/$r" || die "pull of '$r' into $msrc failed"
    pulled=$((pulled + 1))
  done
  echo "mirror: promotion branches current on $msrc ($pulled updated)"
  exit 0
fi
mrefs=$(ci_list MIRROR_REFS "")
# Split forge (#48): only BASE_BRANCH lives on Gitea; the promotion branches and v* tags are
# GitHub-native, so neither is mirrored.
mirror_tags=1
if ci_split_forge; then
  mirror_tags=0
  [[ -z $mrefs ]] && mrefs=$(ci_base_branch)
fi
[[ -z $mrefs ]] && mrefs="$(ci_base_branch) $(ci_list PROMOTION_BRANCHES "")"
gitdir=$(git rev-parse --absolute-git-dir)
mstate="$gitdir/aidoc-ci/mirror.json"

now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }
save_state() { mkdir -p "$(dirname "$mstate")"; jq -n "$@" >"$mstate.tmp" && mv "$mstate.tmp" "$mstate"; }
state_age_min() {  # minutes since last successful sync, or empty when unknown
  local at
  [[ -f $mstate ]] || return 1
  at=$(jq -r '.updated_at // empty' "$mstate" 2>/dev/null)
  [[ -n $at ]] || return 1
  age_minutes "$at" 2>/dev/null
}

if [[ $mode == --check ]]; then
  # Full fetches: per-ref fetch aborts when a mirrored ref does not exist yet.
  git fetch --quiet "$msrc" 2>/dev/null || die "cannot fetch $msrc"
  git fetch --quiet "$mtarget" 2>/dev/null || die "cannot fetch $mtarget"
  refs_json="{}"; fresh=true; reasons="[]"
  for r in $mrefs; do
    s=$(git rev-parse --verify -q "refs/remotes/$msrc/$r") || s=""
    m=$(git rev-parse --verify -q "refs/remotes/$mtarget/$r") || m=""
    # Absent on both sides is vacuously in sync (nothing to replicate).
    eq=false; [[ $s == "$m" ]] && eq=true
    refs_json=$(jq -c --arg r "$r" --arg s "$s" --arg m "$m" --argjson e "$eq" \
      '. + {($r): {gitea:$s, github:$m, equal:$e}}' <<<"$refs_json")
    if [[ $eq != true ]]; then
      fresh=false
      if [[ -z $s ]]; then why="absent on gitea"
      elif [[ -z $m ]]; then why="absent on replica"
      else why="heads differ"; fi
      reasons=$(jq -c --arg r "$r" --arg w "$why" '. + ["ref \($r): \($w)"]' <<<"$reasons")
    fi
  done
  tags_eq=null
  if [[ $mirror_tags == 1 ]]; then
    stags=$(git ls-remote "$msrc" 'refs/tags/v*' 2>/dev/null | awk '{print $1, $2}' | sort) || die "cannot list $msrc tags"
    mtags=$(git ls-remote "$mtarget" 'refs/tags/v*' 2>/dev/null | awk '{print $1, $2}' | sort) || die "cannot list $mtarget tags"
    tags_eq=true; [[ $stags != "$mtags" ]] && { tags_eq=false; fresh=false; reasons=$(jq -c '. + ["v* tags differ"]' <<<"$reasons"); }
  fi
  lag=null; if l=$(state_age_min 2>/dev/null); then lag=$l; else reasons=$(jq -c '. + ["never synced via task mirror"]' <<<"$reasons"); fi
  jq -n --argjson refs "$refs_json" --argjson te "$tags_eq" --argjson lag "$lag" \
    --argjson fresh "$fresh" --argjson reasons "$reasons" \
    '{configured:true, refs:$refs, tags_equal:$te, lag_min:$lag, fresh:$fresh, reasons:$reasons}'
  if [[ $fresh != true ]]; then
    ci_telemetry_event "ci-mirror" "ERROR" "Split-forge mirror stale: $(jq -r 'join(", ")' <<<"$reasons" 2>/dev/null || echo "$reasons")" >/dev/null 2>&1 || true
  fi
  [[ $fresh == true ]] && exit 0 || exit 10
fi

# --- run: plan (all-or-nothing), then execute -------------------------------------------
git fetch --quiet "$msrc" 2>/dev/null || die "cannot fetch $msrc"
git fetch --quiet "$msrc" --tags 2>/dev/null || die "cannot fetch $msrc tags"
git fetch --quiet "$mtarget" 2>/dev/null || die "cannot fetch $mtarget"
plan="[]"; diverged=""
for r in $mrefs; do
  s=$(git rev-parse --verify -q "refs/remotes/$msrc/$r") || s=""
  m=$(git rev-parse --verify -q "refs/remotes/$mtarget/$r") || m=""
  [[ -z $s ]] && { echo "mirror: ref '$r' absent on $msrc — nothing to replicate" >&2; continue; }
  if [[ -z $m ]]; then op=new
  elif [[ $s == "$m" ]]; then op=current
  elif git merge-base --is-ancestor "$m" "$s" 2>/dev/null; then op=update
  else op=diverged; diverged+="$r "; fi
  plan=$(jq -c --arg r "$r" --arg s "$s" --arg o "$op" '. + [{ref:$r, sha:$s, op:$o}]' <<<"$plan")
done
if [[ -n $diverged ]]; then
  ci_telemetry_event "ci-mirror" "ERROR" "Split-forge replica diverged on: ${diverged}" >/dev/null 2>&1 || true
  save_state --arg at "$(now_iso)" --argjson plan "$plan" \
    '{updated_at:$at, status:"diverged", refs:$plan, tags_pushed:0}'
  die "replica diverged on: ${diverged}(someone pushed to $mtarget directly?) — fix the replica by hand, never force"
fi
mtags=""
[[ $mirror_tags == 1 ]] && { mtags=$(git ls-remote "$mtarget" 'refs/tags/v*' 2>/dev/null) || die "cannot list $mtarget tags"; }
while read -r sha ref; do
  [[ -n $sha ]] || continue
  t=${ref#refs/tags/}
  if grep -q "^${sha}[[:space:]]${ref}$" <<<"$mtags"; then continue; fi
  if grep -q "[[:space:]]$ref$" <<<"$mtags"; then
    save_state --arg at "$(now_iso)" --argjson plan "$plan" --arg t "$t" \
      '{updated_at:$at, status:"diverged", refs:$plan, tags_pushed:0}'
    die "tag '$t' moved on the replica — fix it by hand, never force"
  fi
done < <([[ $mirror_tags == 1 ]] && git ls-remote "$msrc" 'refs/tags/v*' 2>/dev/null)
pushed=0
while read -r row; do
  r=$(jq -r .ref <<<"$row"); s=$(jq -r .sha <<<"$row"); o=$(jq -r .op <<<"$row")
  [[ $o == current ]] && continue
  git push --quiet "$mtarget" "$s:refs/heads/$r" || die "push of '$r' failed"
  pushed=$((pushed + 1))
done < <(jq -c '.[]' <<<"$plan")
tags_n=0
# Replicate the source's tags exactly (never local-only tags).
src_tags=""
[[ $mirror_tags == 1 ]] && src_tags=$(git ls-remote "$msrc" 'refs/tags/v*' 2>/dev/null | awk '{sub("^refs/tags/", "", $2); print $1":refs/tags/"$2}')  # exact SHAs, never local tag resolution
if [[ -n $src_tags ]]; then
  # shellcheck disable=SC2086
  git push --quiet "$mtarget" $src_tags || die "tag push failed"
  tags_n=$(wc -w <<<"$src_tags" | tr -d ' ')
fi
save_state --arg at "$(now_iso)" --argjson plan "$plan" --argjson tn "$tags_n" \
  '{updated_at:$at, status:"ok", refs:$plan, tags_pushed:$tn}'
echo "mirror: replica current ($pushed ref(s) pushed, $tags_n tag(s))"
exit 0
