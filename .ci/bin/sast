#!/usr/bin/env bash
# aidoc-local-flow-ci universal SAST (Semgrep) — one scan for all languages in the repo.
#   Rulesets: SEMGREP_CONFIGS (env or .ci-config), default "p/default",
#             plus every rule file under .semgrep/ (custom rules, e.g. ADK/LLM rules).
#   Set SEMGREP_CONFIGS=none to use only local rules (offline / air-gapped).
set -uo pipefail
# shellcheck source=lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
cd "$(ci_root)" || exit 2
command -v semgrep >/dev/null || { echo "sast: semgrep not installed — run 'mise install'" >&2; exit 1; }

configs=${SEMGREP_CONFIGS:-$(ci_config SEMGREP_CONFIGS "p/default")}
args=()
if [[ $configs != none ]]; then
  for c in $configs; do args+=(--config "$c"); done
fi
[[ -d .semgrep ]] && args+=(--config .semgrep/)
has_config=${#args[@]}
# LINT_EXCLUDE also scopes SAST (STANDARD §5); semgrep --exclude takes globs.
for ex in $(ci_list LINT_EXCLUDE ""); do args+=(--exclude "$ex"); done
if [[ $has_config -eq 0 ]]; then
  echo "sast: n/a — no rulesets configured (SEMGREP_CONFIGS=none and no .semgrep/)"; exit 0
fi
exec semgrep scan "${args[@]}" --error --metrics=off --disable-version-check --quiet
