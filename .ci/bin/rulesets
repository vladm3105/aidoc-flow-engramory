#!/usr/bin/env bash
# aidoc-local-flow-ci rulesets — GitHub branch rules as code, derived from .ci-config.
#
#   task rulesets                 print the rulesets (JSON) and repo settings that would be applied
#   task rulesets -- --apply      HUMAN ONLY: create/update them on GitHub (idempotent, by name)
#   task rulesets -- --check      compare live GitHub rulesets + repo settings against .ci-config
#                                 (0 clean, 1 drift, 2 uncheckable: no gh or API failure).
#                                 Live rules outside .ci-config print as EXTRA (warning only —
#                                 a human removes them; --apply never deletes).
# Backend follows ci_forge (CI_FORGE/--forge wins, else the branch upstream
# remote). On Gitea the same .ci-config emits branch protections (one per
# branch: PR-only, approvals, required checks, no force-push; deletion is
# implied by protection) plus repo settings; --check drift semantics kept.
# Gitea gaps (fail-closed, noted on stderr): no bypass actors (roles are
# unexpressible — protections are always strict), no repo-level auto-merge
# gate, and PROMOTION_MODE=ff is refused (it needs admin-push bypass).
#
# Every required check must be produced locally (signoff, review, or a job id in
# .github/workflows/*.yml|*.yaml); entries prefixed `!` pass through unverified
# (escape hatch for name:-overridden, matrix, and external-system checks, whose
# produced names never equal job ids). Unproduced entries warn in dry-run/--check
# and refuse --apply.
#
# Three rulesets (rules aggregate across rulesets; bypass is per ruleset):
#   alfci-integration   BASE_BRANCH (e.g. dev): PR required (0 approvals), required statuses
#                       signoff [+ review when REVIEW=required] [+ RULESET_EXTRA_CHECKS],
#                       no force-push, no deletion. Bypass: repository admins, unless
#                       RULESET_ADMIN_BYPASS=0 (strict: nobody bypasses anything).
#   alfci-promotion-checks   PROMOTION_BRANCHES (staging, main): required server checks
#                       PROMOTION_REQUIRED_CHECKS (default verify) plus the
#                       branch-promotion workflow job (verify-source), unless
#                       PROMOTION_SOURCE_CHECK=0 — NO bypass, admins included.
#                       No signoff/review: promotion branches never use local CI.
#   alfci-promotion-access   PROMOTION_BRANCHES: no force-push, no deletion. ff: only bypass actors
#                       (admins) may update. pr: "PR required" with PROMOTION_APPROVALS approvals
#                       (default 0) instead of the update restriction (PLAN-007 G3).
# Repo settings: allow_auto_merge=true when SHIP_AUTONOMOUS_BRANCHES or PROMOTION_AUTONOMOUS is set;
# delete_branch_on_merge (merged feature branches are pruned; protected branches never are).
#   alfci-mirror (split forge, GitHub side): BASE_BRANCH copy: no deletion, no force-push.
# Replaces the ruleset created by `gh signoff install` (delete that one after applying).
set -euo pipefail
# shellcheck source=lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
cd "$(ci_root)"

orig_args=("$@")
apply=0; check=0
while [[ $# -gt 0 ]]; do case $1 in
  --apply) apply=1; shift ;;
  --check) check=1; shift ;;   # --check wins if both are given (read-only beats write)
  --forge) shift; CI_FORGE=${1:-}; [[ $CI_FORGE == gitea || $CI_FORGE == github ]] || { echo "rulesets: --forge needs gitea or github" >&2; exit 2; }; shift ;;
  *) echo "rulesets: unknown argument: $1 (expected --apply | --check | --forge)" >&2; exit 2 ;;
esac; done
base=$(ci_base_branch)
promotions=$(ci_list PROMOTION_BRANCHES "")
admin_bypass='[{"actor_id":5,"actor_type":"RepositoryRole","bypass_mode":"always"}]'
[[ $(ci_config RULESET_ADMIN_BYPASS 1) == 0 ]] && admin_bypass='[]'
papprovals=$(ci_config PROMOTION_APPROVALS 0)
[[ $papprovals =~ ^[0-9]+$ ]] || { echo "rulesets: PROMOTION_APPROVALS must be a non-negative integer (got: $papprovals)" >&2; exit 2; }

# --- producer guard: every required check needs a local producer ----------------------
# Job ids are the keys at the FIRST indent level under `jobs:` (any width —
# YAML indentation is a style choice, not always two spaces).
# Split forge (#48): the Gitea side reads .gitea/workflows (Gitea ignores .github/ once it exists).
wfdir=.github/workflows
[[ ${RULESETS_SCOPE:-all} == integration && -d .gitea/workflows ]] && wfdir=.gitea/workflows
producers=" signoff review $(awk 'FNR==1{j=0} /^jobs:/{j=1;ind=-1;next} j&&/^[^[:space:]#]/{j=0} j&&/^ +[A-Za-z0-9_.-]+:/{match($0,/^ +/); n=RLENGTH; if(ind<0) ind=n; if(n==ind){id=$1;sub(/:$/,"",id);print id}}' "$wfdir"/*.yml "$wfdir"/*.yaml 2>/dev/null | sort -u | tr '\n' ' ' || true) "
unproduced=(); _out=""
verify_producers() { # $1 = raw checks; sets _out (stripped), appends to unproduced
  local c; _out=""
  # shellcheck disable=SC2086
  for c in $1; do
    case $c in
      '!'*) _out+="${c#!} " ;;
      *) [[ $producers == *" $c "* ]] || unproduced+=("$c"); _out+="$c " ;;
    esac
  done
}
# Each split-forge side (#48) guards only its own checks.
extra_checked=""; promo_checked=""
if [[ ${RULESETS_SCOPE:-all} != promotion ]]; then
  verify_producers "$(ci_list RULESET_EXTRA_CHECKS "")"; extra_checked=$_out
fi
if [[ ${RULESETS_SCOPE:-all} != integration ]]; then
  verify_producers "$(ci_config PROMOTION_REQUIRED_CHECKS verify)"; promo_checked=$_out
fi
# The one-hop chain (dev->staging, staging->main) is enforced by the branch-promotion
# workflow; requiring its job makes the policy a gate instead of advice. Guard-enforced
# like any other check (fail closed when the workflow is missing); PROMOTION_SOURCE_CHECK=0
# opts out. Space-free job id: the required-checks pipeline is space-delimited.
if [[ -n $promotions && $(ci_config PROMOTION_SOURCE_CHECK 1) != 0 && ${RULESETS_SCOPE:-all} != integration ]]; then
  verify_producers "verify-source"; promo_checked+=$_out
fi

# Mirror of verify-source on the integration side (#41): with a promotion chain, the
# verify-integration-source job (branch prefixes, ancestry guard) gates dev merges by default,
# fail closed when its workflow is missing; INTEGRATION_SOURCE_CHECK=0 opts out.
if [[ -n $promotions && $(ci_config INTEGRATION_SOURCE_CHECK 1) != 0 && ${RULESETS_SCOPE:-all} != promotion \
      && " $extra_checked " != *" verify-integration-source "* ]]; then
  verify_producers "verify-integration-source"; extra_checked+=$_out
fi

contexts="signoff"
[[ $(ci_config REVIEW off) == required ]] && contexts+=" review"
contexts+=" $extra_checked"
refs() { local out=() b; for b in "$@"; do out+=("refs/heads/$b"); done; printf '%s\n' "${out[@]}" | jq -R . | jq -sc .; }
checks() { printf '%s\n' "$@" | sed '/^$/d' | jq -R '{context: .}' | jq -sc .; }

# Shared by both backends: refuse --apply (warn otherwise) when a required
# check has no local producer.
if [[ ${#unproduced[@]} -gt 0 ]]; then
  if [[ $apply == 1 ]]; then
    printf 'rulesets: refusing --apply: required checks with no local producer: %s\n' "${unproduced[*]}" >&2
    echo "rulesets: checks are produced by signoff, review, or a job in .github/workflows/ — or prefix with ! to pass through unverified" >&2
    exit 1
  fi
  printf 'rulesets: warning — required checks with no local producer: %s\n' "${unproduced[*]}" >&2
fi

# --- Split forge (#48): integration rules on Gitea, promotion rules on GitHub ------------
# Run once per side; RULESETS_SCOPE limits each run to its branches. Exit = worst of both.
scope=${RULESETS_SCOPE:-all}
if [[ $scope == all ]] && ci_split_forge; then
  prem=$(ci_promotion_remote)
  git remote get-url "$prem" >/dev/null 2>&1 || { echo "rulesets: promotion remote '$prem' missing (PROMOTION_REMOTE)" >&2; exit 2; }
  echo "rulesets: split forge — integration ($base) on gitea, promotion (${promotions:-none}) on github" >&2
  rc=0
  RULESETS_SCOPE=integration CI_FORGE=gitea bash "$0" "${orig_args[@]}" || rc=$?
  if [[ -n $promotions ]]; then
    RULESETS_SCOPE=promotion CI_FORGE=github CI_PUSH_REMOTE=$prem bash "$0" "${orig_args[@]}" || { r=$?; [[ $r -gt $rc ]] && rc=$r; }
  fi
  exit "$rc"
fi
[[ $scope == promotion ]] || [[ $scope == integration ]] || [[ $scope == all ]] || { echo "rulesets: bad RULESETS_SCOPE '$scope'" >&2; exit 2; }

# --- Gitea backend: branch protections (PLAN-006 Phase 3) ---------------------------
# Same inputs, per-branch protections instead of named rulesets. Deletion needs
# no field (the API refuses to delete a protected branch: 403, verified live).
if [[ $(ci_forge) == gitea ]]; then
  branches=()
  [[ $scope == promotion ]] || branches=("$base")
  # Split forge, Gitea side (G9): the promotion branches exist on Gitea only as mirror-only copies for
  # back-merges (task mirror --pull). Only MIRROR_GITEA_USER may push them; no PR merges into them.
  mirror_copies=""
  if [[ $scope == integration ]] && ci_split_forge && [[ -n $promotions ]]; then
    mirror_copies=$promotions
    mguser=$(ci_config MIRROR_GITEA_USER "")
    [[ -n $mguser ]] || echo "rulesets: warning — MIRROR_GITEA_USER unset: the Gitea copies of ${promotions} accept no pushes, so task mirror --pull cannot update them" >&2
  fi
  # shellcheck disable=SC2206
  [[ -n $promotions && $scope != integration ]] && branches+=($promotions)
  pmode=$(ci_config PROMOTION_MODE ff)
  if [[ -n $promotions && $pmode != pr ]]; then
    if [[ $apply == 1 ]]; then
      echo "rulesets: refusing --apply: PROMOTION_MODE=$pmode needs admin-push bypass, unexpressible on Gitea (use PROMOTION_MODE=pr)" >&2
      exit 1
    fi
    echo "rulesets: warning — PROMOTION_MODE=$pmode needs admin-push bypass, unexpressible on Gitea; emitting pr-mode protections (use PROMOTION_MODE=pr)" >&2
  fi
  if [[ $(ci_config RULESET_ADMIN_BYPASS 1) != 0 ]]; then
    echo "rulesets: note — admin bypass is unexpressible on Gitea; emitting strict protections (nobody bypasses)" >&2
  fi
  protections=()
  for b in $mirror_copies; do
    protections+=("$(jq -n --arg b "$b" --arg u "${mguser:-}" '
      {branch_name: $b, rule_name: $b, enable_push: true,
       enable_push_whitelist: true, push_whitelist_usernames: ([$u] | map(select(. != ""))),
       enable_merge_whitelist: true, merge_whitelist_usernames: [],
       enable_force_push: false, enable_bypass_allowlist: false,
       required_approvals: 0, enable_approvals_whitelist: false,
       dismiss_stale_approvals: false,
       block_on_rejected_reviews: false, block_on_outdated_branch: false,
       block_admin_merge_override: true,
       enable_status_check: false, status_check_contexts: []}')")
  done
  for b in "${branches[@]}"; do
    if [[ $b == "$base" ]]; then
      # shellcheck disable=SC2086
      ctx=$(printf '%s\n' $contexts | sed '/^$/d' | jq -R . | jq -sc .)
      protections+=("$(jq -n --arg b "$b" --argjson ctx "$ctx" '
        {branch_name: $b, rule_name: $b, enable_push: false,
         enable_force_push: false, enable_bypass_allowlist: false,
         required_approvals: 0, enable_approvals_whitelist: false,
         dismiss_stale_approvals: false,
         block_on_rejected_reviews: false, block_on_outdated_branch: false,
         block_admin_merge_override: true,
         enable_status_check: true, status_check_contexts: $ctx}')")
    else
      # shellcheck disable=SC2086
      ctx=$(printf '%s\n' $promo_checked | sed '/^$/d' | jq -R . | jq -sc .)
      protections+=("$(jq -n --arg b "$b" --argjson ctx "$ctx" --argjson n "$papprovals" '
        {branch_name: $b, rule_name: $b, enable_push: false,
         enable_force_push: false, enable_bypass_allowlist: false,
         required_approvals: $n, enable_approvals_whitelist: false,
         dismiss_stale_approvals: true,
         block_on_rejected_reviews: false, block_on_outdated_branch: false,
         block_admin_merge_override: true,
         enable_status_check: true, status_check_contexts: $ctx}')")
    fi
  done
  gsettings=$(jq -n '{default_delete_branch_after_merge: true}')

  if [[ $check == 1 ]]; then
    command -v curl >/dev/null || { echo "rulesets: --check needs curl for the gitea backend" >&2; exit 2; }
    [[ -n ${GITEA_TOKEN:-} ]] || { echo "rulesets: --check needs GITEA_TOKEN (gitea backend)" >&2; exit 2; }
    repo=$(forge_repo) || { echo "rulesets: cannot resolve owner/repo from the push remote" >&2; exit 2; }
    live=$(forge_api GET "repos/$repo/branch_protections" 2>&1) \
      || { echo "rulesets: cannot read live protections: $live" >&2; exit 2; }
    [[ -n $live ]] || { echo "rulesets: cannot read live protections: empty response" >&2; exit 2; }
    repo_live=$(forge_api GET "repos/$repo" 2>&1) \
      || { echo "rulesets: cannot read live repo settings: $repo_live" >&2; exit 2; }
    [[ -n $repo_live ]] || { echo "rulesets: cannot read live repo settings: empty response" >&2; exit 2; }
    jq -e . >/dev/null 2>&1 <<<"$live" || { echo "rulesets: cannot read live protections: invalid JSON" >&2; exit 2; }
    jq -e . >/dev/null 2>&1 <<<"$repo_live" || { echo "rulesets: cannot read live repo settings: invalid JSON" >&2; exit 2; }
    # Server-added keys (created_at, updated_at, priority, *_whitelist_* when
    # set) never appear in the emitted payloads and are ignored here.
    cmp=$(jq -n --argjson desired "$(printf '%s\n' "${protections[@]}" | jq -sc .)" \
        --argjson live "$live" --argjson settings "$gsettings" --argjson repo "$repo_live" '
      def norm_p: { branch_name, rule_name,
        enable_push, enable_force_push, enable_bypass_allowlist,
        enable_push_whitelist: (.enable_push_whitelist // false),
        push_whitelist_usernames: ((.push_whitelist_usernames // []) | sort),
        enable_merge_whitelist: (.enable_merge_whitelist // false),
        merge_whitelist_usernames: ((.merge_whitelist_usernames // []) | sort),
        required_approvals, enable_approvals_whitelist,
        dismiss_stale_approvals,
        block_on_rejected_reviews, block_on_outdated_branch,
        block_admin_merge_override, enable_status_check,
        status_check_contexts: ((.status_check_contexts // []) | sort) };
      def project($d; $l): ($d | type) as $t
        | if $t == "object" then
            if ($l | type) != "object" then $l
            else reduce ($d | keys_unsorted[]) as $k ({}; .[$k] = project($d[$k]; $l[$k])) end
          elif $t == "array" then
            if ($l | type) != "array" or (($l | length) != ($d | length)) then $l
            else [range(0; ($d | length)) as $i | project($d[$i]; $l[$i])] end
          else $l end;
      ($desired | map(norm_p) | sort_by(.branch_name)) as $dn
      | ($dn | map(.branch_name)) as $names
      | ([$live[] | select(.branch_name as $n | $names | index($n)) | norm_p] | sort_by(.branch_name)) as $ln
      | project($dn; $ln) as $proj
      | {drift: ($proj != $dn),
         protections: [$dn[] as $d | {branch: $d.branch_name, status:
           ([$ln[] | select(.branch_name == $d.branch_name)] as $m
            | if ($m | length) == 0 then "missing on server"
              elif project($d; $m[0]) != $d then "DRIFT" else "OK" end)}],
         extras: ([$live[] | .branch_name // empty] - $names | unique | sort),
         settings_drift: ($settings != {default_delete_branch_after_merge: $repo.default_delete_branch_after_merge}),
         desired_canon: {protections: $dn, repo_settings: $settings},
         live_canon: {protections: $proj,
                      repo_settings: {default_delete_branch_after_merge: $repo.default_delete_branch_after_merge}}}')
    jq -r '.protections[] | "  \(.branch): \(.status)"' <<<"$cmp"
    jq -r '.extras[]? | "  \(.): EXTRA on server (not in .ci-config — remove by hand if stale)"' <<<"$cmp"
    jq -r '"  repo settings: " + (if .settings_drift then "DRIFT" else "OK" end)' <<<"$cmp"
    if [[ $(jq -r '.drift or .settings_drift' <<<"$cmp") == true ]]; then
      diff -u --label desired --label live <(jq -S .desired_canon <<<"$cmp") <(jq -S .live_canon <<<"$cmp") || true
      echo "rulesets: drift detected — a human applies with: task rulesets -- --apply" >&2
      exit 1
    fi
    echo "rulesets: live protections match .ci-config"
    exit 0
  fi

  if [[ $apply == 0 ]]; then
    printf '%s\n' "${protections[@]}" | jq -s '{protections: ., repo_settings: '"$gsettings"'}'
    echo "rulesets: dry run — a human applies with: task rulesets -- --apply" >&2
    exit 0
  fi

  command -v curl >/dev/null || { echo "rulesets: curl needed for the gitea backend" >&2; exit 1; }
  [[ -n ${GITEA_TOKEN:-} ]] || { echo "rulesets: GITEA_TOKEN not set (gitea backend)" >&2; exit 1; }
  repo=$(forge_repo) || { echo "rulesets: cannot resolve owner/repo from the push remote" >&2; exit 1; }
  existing=$(forge_api GET "repos/$repo/branch_protections" 2>/dev/null || echo '[]')
  failures=0
  for p in "${protections[@]}"; do
    branch=$(jq -r .branch_name <<<"$p")
    rule=$(jq -r --arg b "$branch" '[.[] | select(.branch_name == $b) | .rule_name] | first // empty' <<<"$existing")
    if [[ -n $rule ]]; then
      rule_enc=$(jq -rn --arg r "$rule" '$r|@uri')
      forge_api PATCH "repos/$repo/branch_protections/$rule_enc" "$p" >/dev/null \
        && echo "rulesets: updated protection for $branch" \
        || { echo "rulesets: FAILED to write protection for $branch" >&2; failures=1; }
    else
      forge_api POST "repos/$repo/branch_protections" "$p" >/dev/null \
        && echo "rulesets: created protection for $branch" \
        || { echo "rulesets: FAILED to write protection for $branch" >&2; failures=1; }
    fi
  done
  forge_api PATCH "repos/$repo" "$gsettings" >/dev/null \
    && echo "rulesets: repo settings $(jq -c . <<<"$gsettings")" \
    || { echo "rulesets: FAILED to write repo settings" >&2; failures=1; }
  exit "$failures"
fi

# shellcheck disable=SC2086
integration=$(jq -n --argjson inc "$(refs "$base")" --argjson checks "$(checks $contexts)" --argjson bypass "$admin_bypass" '
  { name: "alfci-integration", target: "branch", enforcement: "active", bypass_actors: $bypass,
    conditions: { ref_name: { include: $inc, exclude: [] } },
    rules: [ {type: "deletion"}, {type: "non_fast_forward"},
      {type: "pull_request", parameters: { required_approving_review_count: 0, dismiss_stale_reviews_on_push: false,
         require_code_owner_review: false, require_last_push_approval: false, required_review_thread_resolution: false }},
      {type: "required_status_checks", parameters: { strict_required_status_checks_policy: false, required_status_checks: $checks }} ] }')

sets=()
[[ $scope == promotion ]] || sets=("$integration")
# Split forge: the GitHub copy of BASE_BRANCH is a mirror. It is never deleted or rewritten
# (PLAN-007); the push restriction to the mirror App comes with phase 2 (G4).
if [[ $scope == promotion ]] && ci_split_forge; then
  # G4: with MIRROR_APP_ID the copy is truly read-only: only the mirror GitHub App may update it.
  mirror_app=$(ci_config MIRROR_APP_ID "")
  mbypass=$admin_bypass; mrules='[{"type":"deletion"},{"type":"non_fast_forward"}]'
  if [[ $mirror_app =~ ^[0-9]+$ ]]; then
    mbypass=$(jq -c --argjson id "$mirror_app" '. + [{actor_id: $id, actor_type: "Integration", bypass_mode: "always"}]' <<<"$admin_bypass")
    mrules='[{"type":"deletion"},{"type":"non_fast_forward"},{"type":"update","parameters":{"update_allows_fetch_and_merge":false}}]'
  fi
  sets+=("$(jq -n --argjson inc "$(refs "$base")" --argjson bypass "$mbypass" --argjson rules "$mrules" '
    { name: "alfci-mirror", target: "branch", enforcement: "active", bypass_actors: $bypass,
      conditions: { ref_name: { include: $inc, exclude: [] } }, rules: $rules }')")
fi
if [[ -n $promotions && $scope != integration ]]; then
  # shellcheck disable=SC2086
  prefs=$(refs $promotions)
  # shellcheck disable=SC2086
  pchecks=$(checks $promo_checked)
  sets+=("$(jq -n --argjson inc "$prefs" --argjson checks "$pchecks" '
    { name: "alfci-promotion-checks", target: "branch", enforcement: "active", bypass_actors: [],
      conditions: { ref_name: { include: $inc, exclude: [] } },
      rules: [ {type: "required_status_checks", parameters: { strict_required_status_checks_policy: false, required_status_checks: $checks }} ] }')")
  # ff: promotions are pushes, so only bypass actors may update. pr: the pull_request rule already
  # confines changes to PRs that pass the required checks; an `update` rule on top would block every
  # promotion merge when nobody bypasses (strict profile) or the merge is autonomous (PLAN-007 G3).
  access_rule='[{"type":"update","parameters":{"update_allows_fetch_and_merge":false}}]'
  pr_rule='[]'
  if [[ $(ci_config PROMOTION_MODE ff) == pr ]]; then
    access_rule='[]'
    pr_rule=$(jq -nc --argjson n "$papprovals" '[{type: "pull_request", parameters: { required_approving_review_count: $n,
      dismiss_stale_reviews_on_push: true, require_code_owner_review: false, require_last_push_approval: false, required_review_thread_resolution: false }}]')
  fi
  sets+=("$(jq -n --argjson inc "$prefs" --argjson bypass "$admin_bypass" --argjson pr "$pr_rule" --argjson access "$access_rule" '
    { name: "alfci-promotion-access", target: "branch", enforcement: "active", bypass_actors: $bypass,
      conditions: { ref_name: { include: $inc, exclude: [] } },
      rules: ([ {type: "deletion"}, {type: "non_fast_forward"} ] + $access + $pr) }')")
fi

# Auto-merge on green is on whenever agents may merge (autoship into dev, autopromote into staging).
settings=$(jq -n --argjson auto "$([[ -n "$(ci_list SHIP_AUTONOMOUS_BRANCHES "")$(ci_list PROMOTION_AUTONOMOUS "")" ]] && echo true || echo false)" \
  '{allow_auto_merge: $auto, delete_branch_on_merge: true}')

if [[ $check == 1 ]]; then
  command -v gh >/dev/null || { echo "rulesets: --check needs the gh CLI (mise install; gh auth login)" >&2; exit 2; }
  live=$(gh api "repos/{owner}/{repo}/rulesets?per_page=100" 2>&1) \
    || { echo "rulesets: cannot read live rulesets: $live" >&2; exit 2; }
  [[ -n $live ]] || { echo "rulesets: cannot read live rulesets: empty response" >&2; exit 2; }
  repo_live=$(gh api "repos/{owner}/{repo}" 2>&1) \
    || { echo "rulesets: cannot read live repo settings: $repo_live" >&2; exit 2; }
  [[ -n $repo_live ]] || { echo "rulesets: cannot read live repo settings: empty response" >&2; exit 2; }
  jq -e . >/dev/null 2>&1 <<<"$live" || { echo "rulesets: cannot read live rulesets: invalid JSON" >&2; exit 2; }
  jq -e . >/dev/null 2>&1 <<<"$repo_live" || { echo "rulesets: cannot read live repo settings: invalid JSON" >&2; exit 2; }
  # The list call returns summaries only (id, name, target, enforcement, …: no rules,
  # conditions or bypass_actors), so each alfci-* ruleset is read in full by id (#44).
  # Server-added keys, present in GET but never in PUT/POST payloads, ignored here:
  # id, node_id, source, source_type, current_user_can_bypass, _links, created_at, updated_at.
  full='[]'
  while IFS= read -r rs_id; do
    [[ -n $rs_id ]] || continue
    one=$(gh api "repos/{owner}/{repo}/rulesets/$rs_id" 2>&1) \
      || { echo "rulesets: cannot read live ruleset $rs_id: $one" >&2; exit 2; }
    jq -e 'type == "object"' >/dev/null 2>&1 <<<"$one" \
      || { echo "rulesets: cannot read live ruleset $rs_id: invalid JSON" >&2; exit 2; }
    full=$(jq -c --argjson one "$one" '. + [$one]' <<<"$full")
  done < <(jq -r '.[] | select((.name // "") | startswith("alfci-")) | .id // empty' <<<"$live")
  cmp=$(jq -n --argjson desired "$(printf '%s\n' "${sets[@]}" | jq -sc .)" \
      --argjson live "$live" --argjson full "$full" --argjson settings "$settings" --argjson repo "$repo_live" '
    def norm_rs: { name: .name, enforcement: .enforcement,
      conditions: {ref_name: { include: ((.conditions.ref_name.include // []) | sort),
                                exclude: ((.conditions.ref_name.exclude // []) | sort)}},
      bypass: ([(.bypass_actors // [])[].actor_id] | sort),
      rules: ([(.rules // [])[]
        | .parameters |= (if type == "object" and has("required_status_checks")
            then .required_status_checks |= (if type == "array" then sort_by(.context) else . end)
            else . end)
        | {type, parameters}
        | if .parameters == null or .parameters == {} then del(.parameters) else . end]
        | sort_by(.type)) };
    # GitHub drops false-default parameters (update_allows_fetch_and_merge: false) from what
    # it stores (#44): a desired false matches a missing live value (and a missing object).
    def project($d; $l): ($d | type) as $t
      | if $t == "object" then
          if $l == null then project($d; {})
          elif ($l | type) != "object" then $l
          else reduce ($d | keys_unsorted[]) as $k ({}; .[$k] = project($d[$k]; $l[$k])) end
        elif $t == "array" then
          if ($l | type) != "array" or (($l | length) != ($d | length)) then $l
          else [range(0; ($d | length)) as $i | project($d[$i]; $l[$i])] end
        elif $d == false and $l == null then false
        else $l end;
    ($desired | map(norm_rs) | sort_by(.name)) as $dn
    | ($dn | map(.name)) as $names
    | ([$full[] | select(.name as $n | $names | index($n)) | norm_rs] | sort_by(.name)) as $ln
    | project($dn; $ln) as $proj
    | {drift: ($proj != $dn),
       rulesets: [$dn[] as $d | {name: $d.name, status:
         ([$ln[] | select(.name == $d.name)] as $m
          | if ($m | length) == 0 then "missing on server"
            elif project($d; $m[0]) != $d then "DRIFT" else "OK" end)}],
       extras: ([$live[] | select((.name // "") | startswith("alfci-")) | .name] - $names | unique | sort),
       settings_drift: ($settings != {allow_auto_merge: $repo.allow_auto_merge,
                                      delete_branch_on_merge: $repo.delete_branch_on_merge}),
       desired_canon: {rulesets: $dn, repo_settings: $settings},
       live_canon: {rulesets: $proj,
                    repo_settings: {allow_auto_merge: $repo.allow_auto_merge,
                                    delete_branch_on_merge: $repo.delete_branch_on_merge}}}')
  jq -r '.rulesets[] | "  \(.name): \(.status)"' <<<"$cmp"
  jq -r '.extras[]? | "  \(.): EXTRA on server (not in .ci-config — remove by hand if stale)"' <<<"$cmp"
  jq -r '"  repo settings: " + (if .settings_drift then "DRIFT" else "OK" end)' <<<"$cmp"
  if [[ $(jq -r '.drift or .settings_drift' <<<"$cmp") == true ]]; then
    diff -u --label desired --label live <(jq -S .desired_canon <<<"$cmp") <(jq -S .live_canon <<<"$cmp") || true
    echo "rulesets: drift detected — a human applies with: task rulesets -- --apply" >&2
    exit 1
  fi
  echo "rulesets: live rulesets match .ci-config"
  exit 0
fi

if [[ $apply == 0 ]]; then
  printf '%s\n' "${sets[@]}" | jq -s '{rulesets: ., repo_settings: '"$settings"'}'
  echo "rulesets: dry run — a human applies with: task rulesets -- --apply" >&2
  exit 0
fi

command -v gh >/dev/null || { echo "rulesets: gh CLI required" >&2; exit 1; }
existing=$(gh api "repos/{owner}/{repo}/rulesets?per_page=100" 2>/dev/null || echo '[]')
tmp=$(mktemp); trap 'rm -f "$tmp"' EXIT
# Like the Gitea backend: attempt every ruleset, count failures, never abort
# mid-apply leaving the set half-applied without a summary.
failures=0
for rs in "${sets[@]}"; do
  name=$(jq -r .name <<<"$rs")
  id=$(jq -r --arg n "$name" '[.[] | select(.name == $n) | .id] | first // empty' <<<"$existing")
  printf '%s' "$rs" >"$tmp"
  if [[ -n $id ]]; then
    if gh api -X PUT "repos/{owner}/{repo}/rulesets/$id" --input "$tmp" >/dev/null; then echo "rulesets: updated $name (#$id)"
    else echo "rulesets: FAILED to update $name" >&2; failures=$((failures + 1)); fi
  else
    if gh api -X POST "repos/{owner}/{repo}/rulesets" --input "$tmp" >/dev/null; then echo "rulesets: created $name"
    else echo "rulesets: FAILED to create $name" >&2; failures=$((failures + 1)); fi
  fi
done
printf '%s' "$settings" >"$tmp"
if gh api -X PATCH "repos/{owner}/{repo}" --input "$tmp" >/dev/null; then echo "rulesets: repo settings $(jq -c . <<<"$settings")"
else echo "rulesets: FAILED to apply repo settings" >&2; failures=$((failures + 1)); fi
[[ $failures -eq 0 ]] || exit "$failures"
if jq -e '.[] | select(.name == "signoff")' <<<"$existing" >/dev/null; then
  echo "rulesets: note — the 'signoff' ruleset from 'gh signoff install' is now redundant; delete it in Settings -> Rules"
fi
