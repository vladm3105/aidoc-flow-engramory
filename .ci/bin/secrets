#!/usr/bin/env bash
# aidoc-local-flow-ci secret scan (gitleaks).
#   default           commits not yet on the base branch (<base>..HEAD) plus a
#                     worktree pass (uncommitted tracked changes + untracked files)
#   --staged          staged changes only (pre-commit)
#   GITLEAKS_LOG_OPTS=--all   full history (server-side verify; no worktree pass)
# A repo-root .gitleaks.toml is auto-discovered by the protect/git passes and
# passed explicitly to the untracked detect pass (no-git mode skips discovery).
set -uo pipefail
# shellcheck source=lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
cd "$(ci_root)" || exit 2
command -v gitleaks >/dev/null || { echo "secrets: gitleaks not installed — run 'mise install'" >&2; exit 1; }

# --- config canary: prove the ruleset detects known-bad values before trusting a scan.
# Runs before every scan (default and --staged). Fixtures are runtime-concatenated
# (never literals: the canon's own full-history scan would trip on them); shapes were
# verified against gitleaks 8.30.1 default rules (aws-access-token, github-pat — both
# require entropy > 3, so low-entropy fakes do NOT match and fail closed here).
if [[ $(ci_config SECRETS_CANARY on) == off ]]; then
  echo "secrets: WARNING — config canary SKIPPED (SECRETS_CANARY=off); a clean scan is unvalidated" >&2
else
  canary_cfg=(); [[ -f .gitleaks.toml ]] && canary_cfg=(--config .gitleaks.toml)
  canary_tmp=""; trap 'rm -rf $canary_tmp' EXIT
  # shellcheck disable=SC2086
  canary_one() { # $1 = name, $2 = secret — 0 validated (or inconclusive), 1 fatal
    local name=$1 secret=$2 attempt d f out rc esc
    esc=$(printf '\033')
    for attempt in 1 2; do
      d=$(mktemp -d); canary_tmp+=" $d"; f=$(mktemp "$d/canary-XXXXXX")
      printf 'canary = "%s"\n' "$secret" >"$f"
      out=$(gitleaks dir "$d" --no-banner --redact "${canary_cfg[@]+"${canary_cfg[@]}"}" \
        --log-level debug --exit-code 1 2>&1 | sed "s/${esc}\[[0-9;]*m//g"); rc=${PIPESTATUS[0]}
      rm -rf "$d"
      case $out in
        *"unable to load"*)
          echo "secrets: canary FAILED — gitleaks config error: $(head -c 300 <<<"$out" | tr '\n' ';')" >&2
          return 1 ;;
        *"leaks found: "*) return 0 ;;
        *"global allowlist"*)
          [[ $attempt == 1 ]] && continue   # retry once at a new random path
          echo "secrets: WARNING — canary inconclusive for $name (path allowlisted after retry); scan unvalidated" >&2
          canary_warn=1; return 0 ;;
        *)
          if [[ $rc -ne 0 ]]; then
            echo "secrets: canary FAILED — scan failed (rc=$rc): $(head -c 300 <<<"$out" | tr '\n' ';')" >&2
          else
            echo "secrets: canary FAILED — no effective rules ($name fixture not detected)" >&2
          fi
          return 1 ;;
      esac
    done
  }
  canary_aws="AKIA"; canary_aws+="Q2W3E4R5"; canary_aws+="T6Y7ZXCV"
  canary_ghp="ghp_"; canary_ghp+="aB1cD2eF3"; canary_ghp+="gH4iJ5kL6"; canary_ghp+="mN7oP8qR9"; canary_ghp+="sT0uVwXyZzAb"
  canary_warn=0
  canary_one aws "$canary_aws" || exit 1
  canary_one ghp "$canary_ghp" || exit 1
  [[ $canary_warn == 0 ]] && echo "secrets: canary ok — rules detect the aws and ghp fixtures"
fi

if [[ ${1:-} == --staged ]]; then
  exec gitleaks git --staged --no-banner --redact
fi

rc_log=0
if [[ -n ${GITLEAKS_LOG_OPTS:-} ]]; then
  opts=$GITLEAKS_LOG_OPTS
  echo "secrets: gitleaks git --log-opts=\"$opts\""
  gitleaks git --no-banner --redact --log-opts="$opts" || rc_log=$?
else
  ref=$(ci_base_ref)
  if [[ -n $ref ]]; then
    opts="$ref..HEAD"
    if [[ -z $(git rev-list "$opts" 2>/dev/null | head -n1) ]]; then
      echo "secrets: n/a — no commits ahead of $ref (log range empty; running worktree pass)"
    else
      echo "secrets: gitleaks git --log-opts=\"$opts\""
      gitleaks git --no-banner --redact --log-opts="$opts" || rc_log=$?
    fi
  else
    echo "secrets: gitleaks git --log-opts=\"HEAD\""
    gitleaks git --no-banner --redact --log-opts="HEAD" || rc_log=$?
  fi
fi

# --- worktree pass (#14): uncommitted and untracked content never appears in a
# log range. Skipped for GITLEAKS_LOG_OPTS (server-side history verify certifies
# the commit, not the runner's scratch tree). Git-ignored paths are never
# scanned, so local-only files (.env) cannot fail the gate.
rc_wt=0
if [[ -z ${GITLEAKS_LOG_OPTS:-} ]]; then
  command -v jq >/dev/null || { echo "secrets: jq needed for the worktree pass" >&2; exit 1; }
  echo "secrets: gitleaks protect (uncommitted tracked changes)"
  gitleaks protect --no-banner --redact || rc_wt=$?
  # Staged-but-uncommitted content is invisible to plain protect (0 bytes
  # scanned) and to the untracked loop below (ls-files --others excludes
  # staged paths), so scan the index too (#43). --staged covers staged only.
  echo "secrets: gitleaks protect --staged (staged changes)"
  gitleaks protect --staged --no-banner --redact || rc_wt=$?
  # detect --no-git does not auto-discover the repo config (D1/D2), so pass
  # it explicitly — same conditional as the canary above.
  wt_cfg=(); [[ -f .gitleaks.toml ]] && wt_cfg=(--config .gitleaks.toml)
  wt_tmp=$(mktemp -d)
  trap 'rm -rf ${canary_tmp:-} "$wt_tmp"' EXIT
  wt_spec=(); mapfile -t wt_spec < <(ci_exclude_specs)
  mapfile -t wt_untracked < <(git ls-files --others --exclude-standard -- "${wt_spec[@]}" .)
  for f in ${wt_untracked[@]+"${wt_untracked[@]}"}; do
    [[ -f $f ]] || continue
    rm -f "$wt_tmp/r.json"  # never attribute a previous file's stale report to this one
    GITLEAKS_STUB_SECRET="" gitleaks detect --no-git --source "$f" \
      "${wt_cfg[@]+"${wt_cfg[@]}"}" --no-banner \
      --report-format json --report-path "$wt_tmp/r.json" >/dev/null 2>&1 || true
    if [[ -n $(jq -r '.[] | .Secret // empty' "$wt_tmp/r.json" 2>/dev/null | head -n1) ]]; then
      echo "secrets: untracked file '$f' contains secret-shaped content" >&2; rc_wt=1
    fi
  done
fi

[[ $rc_log -eq 0 && $rc_wt -eq 0 ]]
