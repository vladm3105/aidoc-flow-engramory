{
  "$schema": "https://aidoc-flow.io/schemas/docs-sync-config-v1.json",
  "version": 1,
  "_comment": "Per-consumer docs-sync configuration (dry_run rollout).",

  "dry_run": true,

  "changelog_stub": {
    "enabled": true,
    "trigger_paths": [".github/workflows/*.yml", "scripts/**"],
    "destination": "docs/archive/CHANGELOG.md",
    "section_header": "## [Unreleased]"
  },

  "version_sync": {
    "enabled": false,
    "sources": [
      { "version_file": "pyproject.toml", "targets": ["README.md"] }
    ]
  },

  "cross_ref_repair": {
    "enabled": false,
    "rename_threshold": 50,
    "allowed_paths": ["docs/archive/CHANGELOG.md", "README.md", "docs/**", "*.md"]
  },

  "allowed_paths": [
    "docs/archive/CHANGELOG.md",
    "README.md",
    "docs/**",
    "*.md"
  ]
}
