# ==============================================================================
# Database Configuration Template (PostgreSQL 18 & PgBouncer)
# Reference: platform-databases, DOC-ONB-DB-01, technology_stack/05
# Stage-First Development Standard: Connects to shared Stage PgBouncer pool.
# Direct access to PostgreSQL port 5432 is strictly prohibited.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Address & Connection Pool (PgBouncer)
# ------------------------------------------------------------------------------
# Primary Target: Stage Host Tenant Gateway Socket on platform0 (10.250.0.1:6432)
# Mesh Target (Workstations & Remote Runners): https://postgres.int.aiops-flow.io:6432
# Local Dev Workstation fallback (if running standalone docker-compose):
# DB_HOST="127.0.0.1"
# DB_PORT=6432
DB_HOST="10.250.0.1"
DB_PORT=6432

# Project Database & Role Naming Conventions
DB_NAME="db_proj_platform-engramory"
DB_USER="stage_svc_platform-engramory"

# Session Pool for DDL Migrations (Transaction pool forbids certain DDL)
DB_MIGRATION_POOL="db_proj_platform-engramory_session"

# Application Connection String (Transaction Pool)
DATABASE_URL="postgresql://stage_svc_platform-engramory:<PASSWORD>@10.250.0.1:6432/db_proj_platform-engramory"

# ------------------------------------------------------------------------------
# 2. Connection Pool Limits & Timeouts
# ------------------------------------------------------------------------------
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_LOCK_TIMEOUT_MS=3000
DB_STATEMENT_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# 3. Read-Only Superset Role (Estate Observability)
# ------------------------------------------------------------------------------
DB_RO_USER="stage_ro_superset"
