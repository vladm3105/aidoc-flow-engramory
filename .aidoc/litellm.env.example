# ==============================================================================
# LiteLLM Gateway Configuration (Default Platform LLM Provider)
# Reference: platform-technology-stack/16-tri-environment-dev-stage-prod.md & Rule D14
# Stage-First Development Standard: Development connects to shared stage first.
# ==============================================================================

# Standard OpenAI SDK Base URL & API Key
# Staging Environment (Stage-First default via Tailscale mesh or host dummy interface 10.250.0.1):
OPENAI_BASE_URL=http://10.250.0.1:4001/v1
# Virtual key issued for this project (or retrieved at runtime via OpenBao kv/stage/platform-engramory/agents/litellm_key):
OPENAI_API_KEY=sk-litellm-platform-engramory-key-stage

# Local Dev Workstation (Fallback only if missing on stage or brand-new project):
# OPENAI_BASE_URL=http://localhost:4000/v1
# OPENAI_API_KEY=sk-litellm-platform-engramory-key-dev

# CI Code Reviewer (.ci-config / review-llm)
LLM_URL=http://10.250.0.1:4001/v1
LLM_API_KEY=sk-litellm-platform-engramory-key-stage
LLM_MODEL=auto

# Platform-Managed Tier Aliases (Do NOT hardcode vendor models)
DEFAULT_LLM_MODEL=auto
FAST_LLM_MODEL=tier-fast
SMART_LLM_MODEL=tier-smart
REASONING_LLM_MODEL=tier-reasoning
REGULATED_LLM_MODEL=regulated

# CLI Agent Runners
CODEX_AGENT_MODEL=agent/codex
AGY_AGENT_MODEL=agent/agy
CLAUDE_AGENT_MODEL=agent/claude
COPILOT_AGENT_MODEL=agent/copilot
