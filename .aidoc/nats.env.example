# Platform NATS JetStream Environment Configuration Template
# Target: .aidoc/nats.env.example

# Primary JetStream Connection URL
# On shared Stage host, defaults to 10.250.0.1:4222
NATS_URL=nats://10.250.0.1:4222

# Client and Monitoring Ports
NATS_CLIENT_PORT=4222
NATS_MONITOR_PORT=8222

# Authentication Credentials (Leave blank if using host gateway or unauthenticated local dev)
NATS_USER=
NATS_PASSWORD=
NATS_TOKEN=
NATS_CREDS_FILE=
