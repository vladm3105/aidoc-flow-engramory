# ==============================================================================
# OpenTelemetry, HyperDX & Coroot Observability Configuration Template
# ==============================================================================
# Compliant with: platform-technology-stack/08, platform-technology-stack/09 §3.22,
#                 DOC-ONB-OBS-01, technology_stack/21 §2.3
# Authority: aidoc-observability-monitoring (ClickHouse + HyperDX + Coroot + Langfuse)
#
# Stage-First Development Standard:
#   All projects and services target the shared platform infrastructure running on Staging.
#   Local standalone dev containers are strictly reserved for brand-new services or when
#   required software is missing on stage.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OpenTelemetry Exporter Configuration
# ------------------------------------------------------------------------------
# Primary Target: Stage Host Tenant Gateway Socket on platform0 (10.250.0.1:24318)
# Mesh Target (Workstations & Remote Runners): https://telemetry.int.aiops-flow.io
# Local Dev Stack Fallback: http://localhost:14318
OTEL_EXPORTER_OTLP_ENDPOINT="http://10.250.0.1:24318"
OTEL_EXPORTER_OTLP_PROTOCOL="http/protobuf"

# Service Identification for HyperDX & Coroot Filter Queries
OTEL_SERVICE_NAME="platform-engramory"
OTEL_SERVICE_VERSION="0.1.0"
OTEL_DEPLOYMENT_ENVIRONMENT="staging"

# Standard Resource Attributes (RFC compliant, comma-separated key=value)
# project.id enables fleet-wide cross-project pivoting in HyperDX and Support Desk
OTEL_RESOURCE_ATTRIBUTES="service.name=platform-engramory,service.version=0.1.0,deployment.environment=staging,project.id=platform-engramory"

# Sampling configuration (1.0 = 100% trace capture in dev/stage; adjust for production)
OTEL_TRACES_SAMPLER="parentbased_always_on"

# ------------------------------------------------------------------------------
# 2. HyperDX Operational APM & Log Explorer
# ------------------------------------------------------------------------------
# Web Dashboard: https://hyperdx.int.aiops-flow.io (NetBird mesh) or http://100.98.134.10:18080
# Direct ClickHouse Analytical Endpoint: http://10.250.0.1:18123 (database: hyperdx)
#
# Query Syntax Examples:
#   Filter project logs:   ServiceName:platform-engramory level:error
#   Filter project traces: ServiceName:platform-engramory Duration:>500ms
#   Correlate via TraceId: TraceId:<TRACE_ID>
HYPERDX_URL="https://hyperdx.int.aiops-flow.io"

# ------------------------------------------------------------------------------
# 3. Coroot Zero-Code Kernel APM & Live Topology Map
# ------------------------------------------------------------------------------
# Web Dashboard: https://coroot.int.aiops-flow.io (NetBird mesh) or http://100.98.134.10:18085
#
# Coroot Invariants for Docker Compose & Container Packaging:
#   - Name containers with 'platform-engramory-<service>' for automatic topology mapping.
#   - Declare explicit 'healthcheck' in compose/Dockerfile to compute Service Availability SLOs.
#   - Define CPU/memory limits to enable OOM kill detection and CPU throttling alerts.
#   - Coroot maps outbound TCP dependencies to 10.250.0.1 automatically (PgBouncer, Valkey, LiteLLM).
COROOT_URL="https://coroot.int.aiops-flow.io"

# ------------------------------------------------------------------------------
# 4. Langfuse LLM Observability & Prompt Management
# ------------------------------------------------------------------------------
# Web Dashboard: https://langfuse.int.aiops-flow.io (NetBird mesh) or http://100.98.134.10:13000
#
# AI Spans Stream-Splitting:
#   The central OTel Collector automatically inspects spans and routes any span containing
#   'gen_ai.*', 'openinference.*', or 'llm.*' attributes to Langfuse.
#   Projects do NOT need a separate Langfuse exporter endpoint if emitting standard OTel GenAI spans.
LANGFUSE_URL="https://langfuse.int.aiops-flow.io"

# ------------------------------------------------------------------------------
# 5. FileLog & Trajectory Spooling (Interlog & XP-Capture)
# ------------------------------------------------------------------------------
# For CLI coding agents and daemon processes writing to disk:
# The OTel Collector automatically tails and ingests:
#   - /workspace/**/.interlog/private.log (operational logs)
#   - /workspace/**/.xp-capture/events.jsonl (agent trajectories)
INTERLOG_DIR=".interlog"
XP_CAPTURE_DIR=".xp-capture"
