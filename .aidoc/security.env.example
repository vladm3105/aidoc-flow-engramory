# ==============================================================================
# Security Suite & Centralized Security Gate Configuration Template
# ==============================================================================
# Compliant with: platform-technology-stack/06, platform-technology-stack/09 §3.2,
#                 platform-technology-stack/27, platform-security (6 Pillars)
# Authority: platform-security (Centralized Rootless Security Gate)
#
# Stage-First Development Standard:
#   All projects target the shared rootless Security Gate on Staging.
#   Provides 3-mode evaluation (in_process, unix_socket, http), Cedar authz,
#   live kill-switch revocation, 4-tier DLP, antivirus, and SSRF egress control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Security Gate Connectivity & Operating Mode
# ------------------------------------------------------------------------------
# Mode selection:
#   unix_socket: Stage/Prod rootless socket (recommended, sub-millisecond, zero-network)
#   http:        Host tenant gateway endpoint via platform mesh (10.250.0.1:8095)
#   in_process:  Direct zero-hop Python evaluation (unit testing & CI offline test runs)
SECURITY_GATE_MODE="unix_socket"

# Unix Domain Socket Path (Per-tenant or shared rootless run directory)
SECURITY_GATE_SOCKET="/run/platform-security/gate.sock"

# HTTP Endpoint (Rootless pasta gateway or stage mesh endpoint)
SECURITY_GATE_URL="http://10.250.0.1:8095"

# Security Gate Authentication Bearer Token
# Sourced securely via OpenBao (never commit plaintext secrets)
SECURITY_GATE_TOKEN="platform-engramory-gate-token"

# ------------------------------------------------------------------------------
# 2. Identity & OIDC Plane (Pillar 2 Authentik Integration)
# ------------------------------------------------------------------------------
# Canonical Authentik OIDC Issuer & JWKS Endpoints
AUTHENTIK_ISSUER_URL="https://auth-stage.aiops-flow.io/application/o/platform-engramory/"
AUTHENTIK_JWKS_URL="https://auth-stage.aiops-flow.io/application/o/platform-engramory/jwks/"
AUTHENTIK_AUDIENCE="platform-engramory"

# ------------------------------------------------------------------------------
# 3. Threat Defense, DLP & Network Egress Control (Pillars 4 & 6)
# ------------------------------------------------------------------------------
# Project namespace boundary (platform | aidoc | b-local | security)
SECURITY_NAMESPACE="aidoc"

# Autonomy Tier for Agent Operations: green (read-only/safe) | yellow (approval) | red (critical)
DEFAULT_AUTONOMY_TIER="green"

# Egress Allowlist Policy: strict enforcement against SSRF and unauthorized external endpoints
EGRESS_GUARD_ENABLED="true"

# ------------------------------------------------------------------------------
# 4. Platform Mesh Network
# ------------------------------------------------------------------------------
# Docker network attaching containers to the shared rootless platform mesh
PLATFORM_MESH_NETWORK="platform-mesh"
