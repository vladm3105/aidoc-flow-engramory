# ==============================================================================
# OpenBao Secrets Management & Dynamic Credential Configuration Template
# ==============================================================================
# Compliant with: platform-technology-stack/06, platform-technology-stack/09 §3.2,
#                 DOC-ONB-SEC-01, technology_stack/21 §2.3
# Authority: platform-stage-ops (stacks/platform-openbao)
#
# Stage-First Development Standard:
#   All projects target the shared OpenBao secrets engine running on Staging.
#   Plaintext secrets must NEVER be committed to Git or written to persistent disk files.
#   At runtime, secrets are read into RAM (tmpfs /run/user/<uid>/ or /run/platform/) mode 0400.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Address & Connectivity
# ------------------------------------------------------------------------------
# Primary Target: Stage Host Tenant Gateway Socket on platform0 (10.250.0.1:8200)
# Mesh Target (Workstations & Remote Runners): https://openbao.int.aiops-flow.io
# Internal Docker Network (platform namespace): http://openbao:8200
BAO_ADDR="http://10.250.0.1:8200"

# Target Environment namespace (dev | stage | prod)
BAO_ENV="stage"

# ------------------------------------------------------------------------------
# 2. Secret Mount Paths & Compartmentalization
# ------------------------------------------------------------------------------
# Policy enforces strict per-project isolation: kv/<env>/platform-engramory/*
# Projects cannot query or list secrets outside their declared project boundary.
BAO_SECRET_PATH="kv/stage/platform-engramory"

# ------------------------------------------------------------------------------
# 3. Authentication Patterns
# ------------------------------------------------------------------------------
# Pattern A: AppRole Authentication (Production Services & Microservices)
# Sourced from runtime environment or RAM-backed token:
BAO_ROLE_ID=""
BAO_SECRET_ID=""

# Pattern B: Authentik JWT Token Exchange (Autonomous AI Coding Agents)
# Agent signs in via Authentik app password -> exchanges JWT at OpenBao auth/jwt-agents
# Grants access strictly to kv/<env>/platform-engramory/agents/*
BAO_JWT_ROLE="agent-platform-engramory"

# Pattern C: Local Development Token (Development Workstations Only)
# In local dev only; NEVER configure in staging or production
# BAO_TOKEN="s.platform-dev-token"
