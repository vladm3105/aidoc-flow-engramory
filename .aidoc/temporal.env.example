# ==============================================================================
# Temporal Workflow Plane & Durable Agent Execution Configuration Template
# Reference: platform-temporal, DOC-ONB-WF-01, technology_stack/16
# Stage-First Development Standard: Connects to shared Stage Temporal cluster first.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Address & Connection
# ------------------------------------------------------------------------------
# Primary Target: Stage Host Tenant Gateway Socket on platform0 (10.250.0.1:7233)
# Mesh Target (Workstations & Remote Runners): https://temporal.int.aiops-flow.io:7233
# Local Dev Workstation fallback (if running standalone docker-compose):
# TEMPORAL_HOST="127.0.0.1:7233"
TEMPORAL_HOST="10.250.0.1:7233"

# Web UI Dashboard (Read-only visibility & debugging)
TEMPORAL_WEB_URL="https://temporal.int.aiops-flow.io"

# ------------------------------------------------------------------------------
# 2. Namespace & Task Queue Isolation
# ------------------------------------------------------------------------------
# Policy enforces strict per-project namespace and task queue isolation:
TEMPORAL_NAMESPACE="platform-engramory"
TEMPORAL_TASK_QUEUE="platform-engramory-agents"

# ------------------------------------------------------------------------------
# 3. Security & mTLS (Required on Staging and Production)
# ------------------------------------------------------------------------------
# Sourced from volatile RAM (/dev/shm) or provisioned secrets mounts:
TEMPORAL_TLS_CERT_PATH=""
TEMPORAL_TLS_KEY_PATH=""
TEMPORAL_TLS_CA_PATH=""
